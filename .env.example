# Configuración de Ubicame Directory (ubicame.info)

# Base de datos compartida con ubicame.cc (PostgreSQL)
# En producción, configurar con las credenciales reales:
# DATABASE_URL=postgresql://usuario:password@host:5432/ubicame_db
DATABASE_URL=

# Para forzar uso de datos locales mock incluso si DATABASE_URL está definido
USE_LOCAL_DATA=false

# SSL para PostgreSQL (por defecto true en producción)
DATABASE_SSL=true

# ImgBB API Key para subida rápida de fotos en /agregar
IMGBB_API_KEY=

# Google OAuth Client ID para identificación en 1 clic en /agregar
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Puerto del servidor (por defecto 3000)
PORT=3000
